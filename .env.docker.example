# Server configuration. On the server this file is named ".env" (cp .env.docker.example .env).
# Never commit .env. Fastest way to create it with random secrets: see docs/DEPLOY-HOSTINGER.md step 2.

# --- Database ---
# Password for the PostgreSQL container that runs next to the app. Use letters and digits only
# (for example: openssl rand -hex 24), because it is placed inside a connection URL.
POSTGRES_PASSWORD=""
# Leave EMPTY to use that container. Set it only to use an external database such as Neon.
DATABASE_URL=""

# --- Secrets: generate each with  openssl rand -hex 32 ---
PAYMENT_WEBHOOK_SECRET=""
# Encrypts saved SMPP vendor passwords. Keep it stable: changing it means re-saving vendor passwords.
SMPP_ENCRYPTION_KEY=""

# --- How the site is reached ---
# Plain HTTP on the server's IP address (no domain yet):
SITE_ADDRESS=:80
COOKIE_SECURE=false
# With a domain whose DNS points at the server (automatic HTTPS):
#   SITE_ADDRESS=vnum.example.com
#   COOKIE_SECURE=true

# --- Demo behaviour ---
# "true" shows the demo logins on the sign-in page. Use "false" once real users sign in.
DEMO_MODE=true
# Passwords for the demo accounts created by the seed (optional; defaults are in the README).
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# --- Optional: change the published ports (defaults 80 / 443) ---
# HTTP_PORT=80
# HTTPS_PORT=443
