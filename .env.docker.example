# Copy to ".env" on the server (cp .env.docker.example .env) and fill in. Never commit .env.

# --- Database: your Neon connection string ---
DATABASE_URL=""

# --- Secrets: generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=""
SMPP_ENCRYPTION_KEY=""

# --- How the site is reached ---
# Plain HTTP on the server's IP address (no domain yet):
SITE_ADDRESS=:80
COOKIE_SECURE=false
# With a domain whose DNS points at the server (automatic HTTPS):
#   SITE_ADDRESS=vnum.example.com
#   COOKIE_SECURE=true

# --- Demo behaviour ---
# "true" shows the demo logins on the sign-in page. Use "false" once real users sign in.
DEMO_MODE=true
# Passwords for the demo accounts created by the seed (optional; defaults are in the README).
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# --- Optional: change the published ports (defaults 80 / 443) ---
# HTTP_PORT=80
# HTTPS_PORT=443
