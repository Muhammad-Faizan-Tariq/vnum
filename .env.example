# --- Database (PostgreSQL). Use your Neon connection string in staging/production. ---
# Neon: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Local: `npm run db:local` starts a real Postgres on port 54329 with these databases.
DATABASE_URL="postgresql://vnum:vnum_local_only@localhost:54329/vnum_dev"

# --- Payment simulation ---
# Shared secret used to sign/verify simulated payment callbacks (HMAC-SHA256). Min 16 chars.
PAYMENT_WEBHOOK_SECRET="change-me-to-a-long-random-string"

# --- Demo behaviour ---
# Shows the seeded demo credentials on the sign-in page. Set to "false" anywhere real people sign in.
DEMO_MODE="true"

# --- Seed passwords (optional; defaults are documented in the README) ---
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
