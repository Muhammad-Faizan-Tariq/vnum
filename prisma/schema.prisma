generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_SANDBOX
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  BTC_SIM
  USDT_TRC20_SIM
  USDT_ERC20_SIM
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  UNDELIVERABLE
  REJECTED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  sessions    Session[]
  orders      Order[]
  messages    Message[]
  activityLog ActivityLog[]

  @@index([role, status])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id       String          @id @default(cuid())
  slug     String          @unique
  name     String
  numbers  NumberService[]
}

model VirtualNumber {
  id          String       @id @default(cuid())
  e164        String       @unique
  countryCode String // ISO 3166-1 alpha-2
  countryName String
  region      String?
  priceCents  Int
  status      NumberStatus @default(AVAILABLE)
  smsInbound  Boolean      @default(true)
  voice       Boolean      @default(false)
  /// Identifier of the adapter that supplies this number. "demo" = seeded test inventory.
  provider    String       @default("demo")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  services NumberService[]
  orders   Order[]
  messages Message[]

  @@index([countryCode, status])
  @@index([status, priceCents])
}

model NumberService {
  numberId  String
  serviceId String

  number  VirtualNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([numberId, serviceId])
  @@index([serviceId])
}

model Order {
  id             String      @id @default(cuid())
  /// Human-friendly reference, e.g. VN-7K3Q9X
  reference      String      @unique
  userId         String
  numberId       String
  status         OrderStatus @default(PENDING_PAYMENT)
  amountCents    Int
  idempotencyKey String
  expiresAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  number   VirtualNumber @relation(fields: [numberId], references: [id])
  payments Payment[]
  messages Message[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([numberId])
}

model Payment {
  id           String        @id @default(cuid())
  reference    String        @unique
  orderId      String
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amountCents  Int
  /// Simulated crypto amount, stored as a decimal string.
  cryptoAmount String
  cryptoSymbol String
  /// Clearly fake deposit address, generated by the mock adapter.
  depositAddress String
  failureReason  String?
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  /// Provider-supplied event id; unique so replayed callbacks are no-ops.
  eventId   String   @unique
  paymentId String
  type      String
  payload   Json
  outcome   String
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model Message {
  id            String           @id @default(cuid())
  userId        String
  numberId      String?
  orderId       String?
  direction     MessageDirection
  fromAddress   String
  toAddress     String
  body          String
  status        MessageStatus    @default(QUEUED)
  /// Simulated SMPP message id (submit_sm_resp).
  smppMessageId String?
  /// SMPP command_status style code, e.g. ESME_ROK.
  commandStatus String?
  errorDetail   String?
  /// When the simulator will emit the delivery receipt.
  receiptDueAt  DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime         @default(now())

  user   User           @relation(fields: [userId], references: [id])
  number VirtualNumber? @relation(fields: [numberId], references: [id])
  order  Order?         @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@index([status, receiptDueAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
